<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="doc_template_tree" model="ir.ui.view">
        <field name="name">Doc Template List</field>
        <field name="model">hr.contract.doc_template</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="contract_type"/>
                <field name="template_file" widget="binary"/>
            </tree>

        </field>
    </record>


    <record id="doc_template_action"  model="ir.actions.act_window">
        <field name="name">Doc Template</field>
        <field name="res_model">hr.contract.doc_template</field>
        <field name="view_mode">tree</field>
    </record>


<menuitem
        id="doc_template_menu"
        name="Contract Templates"
        action="doc_template_action"
        parent="hr.menu_config_employee"
        sequence="20"
        groups="hr_contract.group_hr_contract_manager"/>



</odoo>
