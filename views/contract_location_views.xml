<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id='contract_location_list' model='ir.ui.view'>
        <field name="name">Contract Location</field>
        <field name="model">hr.contract.location</field>
        <field name="arch" type="xml">
            <list editable="bottom" >
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="contract_location_action" model="ir.actions.act_window">
        <field name="name">Contract Location</field>
        <field name="res_model">hr.contract.location</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="contract_location_menu"
              name="Contract Location"
              parent="hr.menu_config_employee"
              sequence="3"
              groups="hr_contract.group_hr_contract_manager"
              action="contract_location_action"/>

</odoo>
