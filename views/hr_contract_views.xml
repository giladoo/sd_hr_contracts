<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_contract_view_list_inherit_sd_hr_contracts" model="ir.ui.view">
        <field name="name">hr_contract.hr_contract_view_list.view.list.inherit.sd_hr_contracts</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
<!--                    <button class="btn btn-outline-primary" name="generate_and_download_docx"-->
<!--                            type="object" icon="fa-file-word-o">-->
<!--                        Download .docx-->
<!--                    </button>-->
                    <button string="Download .doc" class="btn btn-outline-primary" name="generate_and_download_docx"
                            type="object"  icon="fa-file-word-o"></button>

                </header>
            </xpath>

        </field>
    </record>

    <record id="hr_contract_view_form_inherit_sd_hr_contracts" model="ir.ui.view">
        <field name="name">hr_contract.hr_contract_view_form.view.form.inherit.sd_hr_contracts</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <header>
                <button class="btn btn-outline-primary" name="generate_and_download_docx"
                        type="object" icon="fa-file-word-o">
                    Download .docx
                </button>
            </header>

            <xpath expr="//field[@name='name']" position="attributes">
               <attribute name="readonly">False</attribute>
            </xpath>
            <xpath expr="//field[@name='wage']" position="attributes">
               <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//div[@name='wage_period_label']" position="attributes">
               <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='contract_type_id']" position="attributes">
<!--               <attribute name="readonly">id != False</attribute>-->
            </xpath>
            <xpath expr="//field[@name='hr_responsible_id']" position="after">

                <field name="doc_template" options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                       domain="[('contract_type', '=', contract_type_id)]"/>
                <field name="output_file_name" invisible="1"/>
                <field name="output_pdf_name" invisible="1"/>
                <field name="output_file" widget="binary" invisible="1" readonly="1" filename="output_file_name" style="direction: ltr !important;"/>
                <field name="output_pdf" widget="binary" invisible="1" readonly="1" filename="output_pdf_name" style="direction: ltr !important;"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <group>
                    <field name="subject"/>

                </group>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="before">
                <field name="representative"/>
                <field name="issue_date"/>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="project_name"/>
            </xpath>
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
            </xpath>
            <xpath expr="//page[@name='information']/group[@name='salary_info']" position="before">
                <field name="contract_type_id_payment" invisible="1"/>
                <group name="hourly_rate_info"  invisible="contract_type_id_payment != 'hourly'">
                    <separator  string="Hourly Rate"  class="ps-2 text-bg-secondary"/>
                    <group>
                        <label for="hourly_rate"/>
                        <div class="o_row mw-50" name="hourly_rate">
                            <field name="hourly_rate" class="oe_inline o_hr_narrow_field" nolabel="1"/>
                            <div class="mb-3 ms-5" name="_period_label">/ Hour</div>
                        </div>
                        <field name="hourly_rate_text"/>
                        <label for="bond"/>
                        <div class="o_row mw-50" name="bond">
                            <field name="bond" class="oe_inline o_hr_narrow_field" nolabel="1"/>
                            <div class="mb-3 ms-5" name="bond_period_label"> % </div>
                        </div>
                    </group>
                </group>
                <group invisible="contract_type_id_payment not in ['monthly', 'rotational', 'retired']">
                    <group>
                        <separator  string="Payroll"  class="ps-2 text-bg-secondary"/>
                        <field name="pr_sum" class="ps-2 text-bg-700"/>
                        <field name="pr_base"/>
                        <field name="pr_absorbent" invisible="contract_type_id_payment == 'retired'"/>
                        <field name="pr_yearly" invisible="contract_type_id_payment == 'retired'"/>
                        <field name="pr_job" invisible="contract_type_id_payment == 'retired'"/>
                        <field name="pr_marriage" invisible="contract_type_id_payment == 'retired'"/>
                        <field name="pr_commute" invisible="contract_type_id_payment == 'retired'"/>
                        <field name="pr_other" invisible="contract_type_id_payment == 'retired'"/>
                        <field name="pr_children" invisible="contract_type_id_payment == 'retired'"/>
                        <field name="pr_housing" invisible="contract_type_id_payment == 'retired'"/>
                        <field name="pr_groceries" invisible="contract_type_id_payment == 'retired'"/>
                        <field name="pr_rotation" invisible="contract_type_id_payment in ['retired', 'monthly']"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//page[@name='information']" position="after">
                <page string="Additional Note">
                    <field name="additional_note" />

                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_contract_type_view_list_inherit" model="ir.ui.view">
        <field name="name">Add payment field</field>
        <field name="model">hr.contract.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_tree"/>
        <field name="arch" type="xml">

        <xpath expr="//list">
            <field name="payment"/>
        </xpath>
        </field>
    </record>
</odoo>
